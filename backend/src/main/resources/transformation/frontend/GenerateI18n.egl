[%
import "FrontendHelpers.eol";

// Get all classes from the metamodel
var allClasses = ePackage.eClassifiers.select(c | c.eAllAttributes.isDefined());
var entityClasses = Sequence{"Cave", "Defect", "Statue", "Mural", "Painting", "Inscription"};

// Collect all unique attribute names
var allAttributes = Sequence{
    "gid", "name", "description", "label", "conservationStatus",
    "creationPeriod", "lastInspectionDate", "inspectionNotes",
    "material", "period", "width", "height", "depth", "subject",
    "technique", "style", "language", "content",
    "defectType", "severity", "detectionDate", "affectedArea",
    "treatmentHistory", "requiresImmediateAction",
    "timestamp", "value", "unit", "expression",
    "x", "y", "z", "roll", "pitch", "yaw",
    "reference", "coordinates", "reading"
};

%]
